<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="WelcomeScene">
   <children>
      <ImageView fitHeight="730.0" fitWidth="1297.0" layoutX="-7.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@loginBackgroud.png" />
         </image>
      </ImageView>
      <Label layoutX="434.0" layoutY="180.0" prefHeight="101.0" prefWidth="454.0" text="Welcome to Pigeon!" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="45.0" />
         </font>
      </Label>
      <Button fx:id="loginbutton" layoutX="536.0" layoutY="314.0" mnemonicParsing="false" onAction="#LoginButton" opacity="0.82" prefHeight="61.0" prefWidth="212.0" style="-fx-background-radius: 10; -fx-background-color: #de7259;" text="LogIn">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="Roboto Bold" size="20.0" />
         </font>
      </Button>
      <Label fx:id="warning" layoutX="496.0" layoutY="293.0" textFill="#89171c">
         <font>
            <Font name="Roboto Italic" size="12.0" />
         </font>
      </Label>
      <Label layoutX="521.0" layoutY="251.0" prefHeight="101.0" prefWidth="454.0" text="Already familiar with Pigeon?" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="17.0" />
         </font>
      </Label>
      <Button fx:id="loginbutton2" layoutX="536.0" layoutY="445.0" mnemonicParsing="false" onAction="#SignUpButton" opacity="0.82" prefHeight="61.0" prefWidth="212.0" style="-fx-background-radius: 10; -fx-background-color: #de7259;" text="SignUp">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="Roboto Bold" size="20.0" />
         </font>
      </Button>
      <Label layoutX="521.0" layoutY="383.0" prefHeight="101.0" prefWidth="454.0" text="New around here?" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="17.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
