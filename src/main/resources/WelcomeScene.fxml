<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ldal.pigeonapp.WelcomeScene">
   <children>
      <ImageView fitHeight="730.0" fitWidth="1297.0" layoutX="-7.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@loginBackgroud.png" />
         </image>
      </ImageView>
      <Label layoutX="434.0" layoutY="180.0" prefHeight="101.0" prefWidth="454.0" text="Welcome to Pigeon!" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="45.0" />
         </font>
      </Label>
      <Button fx:id="loginButton" layoutX="586.0" layoutY="327.0" mnemonicParsing="false" onAction="#LoginButtonEvent" opacity="0.82" prefHeight="36.0" prefWidth="119.0" style="-fx-background-radius: 10; -fx-background-color: #de7259;" text="Log In">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="Roboto Bold" size="20.0" />
         </font>
      </Button>
      <Label fx:id="warning" layoutX="496.0" layoutY="293.0" textFill="#89171c">
         <font>
            <Font name="Roboto Italic" size="12.0" />
         </font>
      </Label>
      <Label layoutX="545.0" layoutY="289.0" prefHeight="38.0" prefWidth="203.0" text="Already familiar with Pigeon?" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="15.0" />
         </font>
      </Label>
      <Button fx:id="signUpButton" layoutX="587.0" layoutY="445.0" mnemonicParsing="false" onAction="#SignUpButton" opacity="0.82" prefHeight="29.0" prefWidth="119.0" style="-fx-background-radius: 10; -fx-background-color: #de7259;" text="Sign Up">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="Roboto Bold" size="20.0" />
         </font>
      </Button>
      <Label layoutX="576.0" layoutY="416.0" prefHeight="29.0" prefWidth="144.0" text="New around here?" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="Roboto Bold" size="17.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
