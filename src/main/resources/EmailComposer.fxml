            <TextArea prefHeight="1000.0" prefWidth="956.0" style="-fx-background-color: transparent;" stylesheets="@textAreaTransparentBG.css" wrapText="true">
               <font>
                  <Font name="Roboto" size="14.0" />
               </font>
            </TextArea>
         </content></ScrollPane>
      <Label layoutX="656.0" layoutY="52.0" text="COMPOSE">
         <font>
            <Font name="Roboto Medium" size="29.0" />
         </font>
      </Label>
      <Rectangle arcHeight="5.0" fill="#e17c65" height="6.0" layoutX="-64.0" layoutY="199.0" smooth="false" stroke="TRANSPARENT" strokeType="INSIDE" width="216.0" />
      <Rectangle arcHeight="5.0" fill="#e07c6557" height="6.0" layoutX="-64.0" layoutY="419.0" smooth="false" stroke="TRANSPARENT" strokeType="INSIDE" width="219.0" />
      <TextField layoutX="261.0" layoutY="112.0" prefHeight="30.0" prefWidth="930.0" style="-fx-background-color: transparent;">
         <font>
            <Font name="Roboto" size="16.0" />
         </font></TextField>
      <TextField layoutX="276.0" layoutY="151.0" prefHeight="30.0" prefWidth="907.0" style="-fx-background-color: transparent;">
         <font>
            <Font name="Roboto" size="16.0" />
         </font>
      </TextField>
   </children>
</AnchorPane>
