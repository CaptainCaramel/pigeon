                  <Image url="@icon.png" />
               </image>
               <effect>
                  <DropShadow height="14.66" radius="5.484999999999999" width="9.28">
                     <color>
                        <Color opacity="0.2328244149684906" />
                     </color>
                  </DropShadow>
               </effect>
            </ImageView>
          <Button mnemonicParsing="false" text="Button" translateX="1090.0" />
            <Button mnemonicParsing="false" text="Button" translateX="960.0" />
        </items>
         <effect>
            <DropShadow height="91.35" radius="22.3375" width="0.0">
               <color>
                  <Color opacity="0.6221374273300171" />
               </color>
            </DropShadow>
         </effect>
      </ToolBar>
      <ScrollPane hbarPolicy="NEVER" layoutX="225.0" layoutY="211.0" prefHeight="469.0" prefWidth="959.0" style="-fx-background-color: transparent; -fx-background: transparent;">
